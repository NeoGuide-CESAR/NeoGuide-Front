# =============================================================================
# NeoGuide-Front — Variáveis de Ambiente de Produção
# =============================================================================

# Porta externa onde o Frontend (Nginx) ficará acessível na VPS (padrão: 80)
FRONT_PORT=80

# Chave X-API-Key para o proxy Nginx autenticar no NeoGuide-NeoChat (porta 8000)
# Deve ser exatamente o mesmo valor de API_KEY configurado no .env do neoguide-neochat
LUMI_API_KEY=coloque_aqui_a_mesma_API_KEY_do_neochat
